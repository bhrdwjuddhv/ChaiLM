PORT=5000
CLIENT_URL=http://localhost:5173
MONGODB_URI=
JWT_SECRET=
OPENAI_API_KEY=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Both optional; leave empty for local development.
# YouTube blocks and throttles datacenter IPs, so playlists that index fine from a
# laptop can return empty transcripts (or a playlist page with 0 videos) on a
# deploy host. A RESIDENTIAL proxy gets through; a datacenter one usually will not.
YOUTUBE_PROXY_URL=
# Official playlist listing (youtube.com/v3/playlistItems). Fixes "0 videos found"
# without a proxy. Transcripts still come from the transcript path above.
YOUTUBE_API_KEY=

# Redis and Qdrant are chosen by env alone — no code change to switch.
# Uncomment ONE block.

# --- Local (docker compose up -d, from this directory) ---
REDIS_URL=redis://localhost:6379
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# --- Cloud ---
# Upstash: use the ioredis/TCP endpoint starting with rediss://, NOT the REST
# URL + token — BullMQ speaks the Redis wire protocol and cannot use the REST
# API. The rediss:// scheme turns on TLS by itself, so no extra TLS config.
# REDIS_URL=rediss://default:<password>@<host>.upstash.io:<port>
# QDRANT_URL=https://<your-cluster>.qdrant.io:6333
# QDRANT_API_KEY=<your-qdrant-api-key>

# Upstash bills per command and BullMQ polls for jobs, so keep worker
# concurrency modest and don't leave idle workers running.
